# ---------------------------------------------------------------------------
# Coolify (staging + production): set these in each Application's
# Environment Variables UI. docker-compose.yaml fills in the rest
# (DATABASE_URL, ATTACHMENTS_DIR, ALLOWED_HOSTS/ORIGINS, ENVIRONMENT).
# ---------------------------------------------------------------------------
# Bare hostname, no scheme. Different per environment:
#   staging: doyoung-demo-staging.ml-capstone.cs.byu.edu
#   prod:    doyoung-demo.ml-capstone.cs.byu.edu
# APP_HOST=doyoung-demo-staging.ml-capstone.cs.byu.edu
#
# Required; deploy fails without it. Generate a separate value per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# SESSION_SECRET=
#
# GitHub App (optional). Use an app registered for THIS domain, not the AWS one:
#   Callback URL: http://<APP_HOST>/integrations/github/callback
#   Webhook: leave inactive. GitHub cannot reach the VPN-only domain, so PR
#   open/merge never moves tickets here; "sync" on the repository settings page works.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=
#
# Not available on the class domains:
#   Gmail intake — Google OAuth rejects http redirect URIs.
#
# After the first deploy, per environment:
#   - register an account, issue an API token (Settings), and point MCP clients at
#     http://<APP_HOST>/mcp with that token (VPN required)
#   - re-add any Slack/Discord/Teams webhooks per project; the database starts empty

# ---------------------------------------------------------------------------
# Local development (`uv run uvicorn app.main:app`): copy to .env. Never commit .env.
# ---------------------------------------------------------------------------
SESSION_SECRET=change-me-to-a-long-random-string
SECURE_COOKIES=false
DATABASE_URL=sqlite:///./kanbanflow.db
ALLOWED_ORIGINS=["http://localhost:8000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
ENVIRONMENT=development

# Gmail ticket intake (optional; leave empty to disable).
# TOKEN_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
TOKEN_ENCRYPTION_KEY=

# Ticket attachments live on disk here (Docker uses /data/attachments, next to the database).
ATTACHMENTS_DIR=data/attachments
