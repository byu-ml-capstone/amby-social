# Copy to .env before running. Never commit .env.
# Generate a real SESSION_SECRET with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me-to-a-long-random-string
SECURE_COOKIES=false
DATABASE_URL=sqlite:///./kanbanflow.db
ALLOWED_ORIGINS=["http://localhost:8000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
ENVIRONMENT=development

# Gmail ticket intake (optional; leave empty to disable).
# TOKEN_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
TOKEN_ENCRYPTION_KEY=

# Ticket attachments live on disk here (Docker uses /data/attachments, next to the database).
ATTACHMENTS_DIR=data/attachments
